{
  "name": "portal-votacao-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json vite.config.ts index.html .prettierrc.json .github/workflows/frontend.yml",
    "format": "prettier --write src tests scripts package.json tsconfig.json vite.config.ts index.html .prettierrc.json .github/workflows/frontend.yml",
    "build": "npm run typecheck && vite build",
    "production": "npm run build",
    "heroku-postbuild": "node scripts/validate-build-config.mjs && npm run build",
    "start": "node scripts/serve-dist.mjs",
    "serve:dist": "npm start",
    "preview": "vite preview --host 127.0.0.1 --port 18184 --strictPort",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:static": "node --test scripts/*.test.mjs",
    "test:browser": "npm --prefix migration-tests run test:candidate",
    "check": "npm run format:check && npm run test:unit && npm run build && npm run test:static",
    "test:runtime": "node --test scripts/runtime.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@mui/material": "9.5.0",
    "@mui/icons-material": "9.5.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@tanstack/react-query": "5.104.4",
    "react-hook-form": "7.90.0",
    "axios": "1.20.0",
    "socket.io-client": "2.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.10.0",
    "@types/socket.io-client": "1.4.36",
    "@types/socket.io": "2.1.13",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.5",
    "prettier": "3.9.10",
    "socket.io": "2.3.0"
  },
  "description": "Portal de votação Gladius — frontend"
}
